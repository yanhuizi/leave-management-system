<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><html><head><title>审批管理</title></head><body><h2>审批管理</h2><table border="1"><tr><th>申请人</th><th>类型</th><th>时间</th><th>原因</th><th>状态</th><th>操作</th></tr><c:forEach var="x" items="${requests}"><tr><td>${x.student_name}</td><td>${x.type}</td><td>${x.start_time} 至 ${x.end_time}</td><td>${x.reason}</td><td>${x.status}</td><td><form method="post"><input type="hidden" name="id" value="${x.id}"><select name="status"><option>通过</option><option>驳回</option></select><input name="comment" placeholder="审批意见"><button>提交</button></form></td></tr></c:forEach></table></body></html>
