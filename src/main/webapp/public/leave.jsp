<%@ page contentType="text/html;charset=UTF-8" %><% if(session.getAttribute("userId")==null){response.sendRedirect(request.getContextPath()+"/login");return;} %><html><head><title>请假申请</title></head><body><h2>请假申请</h2><p style="color:red">${error}</p><form method="post" action="${pageContext.request.contextPath}/leave">类型：<select name="type"><option>事假</option><option>病假</option><option>公假</option></select><br>开始：<input type="datetime-local" name="startTime" required><br>结束：<input type="datetime-local" name="endTime" required><br>原因：<textarea name="reason" required></textarea><br><button>提交申请</button></form><a href="${pageContext.request.contextPath}/leave/list">查看我的申请</a></body></html>
