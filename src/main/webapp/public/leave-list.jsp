<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><html><head><title>我的请假</title></head><body><h2>我的请假记录</h2><table border="1"><tr><th>类型</th><th>开始</th><th>结束</th><th>原因</th><th>状态</th><th>审批意见</th></tr><c:forEach var="x" items="${requests}"><tr><td>${x.type}</td><td>${x.start_time}</td><td>${x.end_time}</td><td>${x.reason}</td><td>${x.status}</td><td>${x.review_comment}</td></tr></c:forEach></table><a href="${pageContext.request.contextPath}/leave">申请请假</a></body></html>
