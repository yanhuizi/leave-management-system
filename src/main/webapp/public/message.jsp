    <li><a href="javascript:void(0);">错误提示</a></li>
    </ul>
    </div>
    
    <div class="error">
    
    <h2>${requestScope.title }</h2>
    <p>${requestScope.message }</p>
    <p>${requestScope.url }</p>
    <div class="reindex"><a href="${requestScope.url}" target="rightFrame">返回</a></div>
    
    </div>


