<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>leave-management-system</display-name>

    <!-- 素材 qingjia 工程的初始化 Servlet：启动时把字典数据放进 application。 -->
    <servlet>
        <servlet-name>InitServlet</servlet-name>
        <servlet-class>com.huizi.leave.leavemanagementsystem.servlet.InitServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- 素材的分页过滤器：pageNo 参数与 forwordUrl 转发。 -->
    <filter>
        <filter-name>pageFilter</filter-name>
        <filter-class>com.huizi.leave.leavemanagementsystem.page.PageFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>pageFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- JSTL 核心标签库的显式映射：
         让 IDE 直接从工程内的 TLD 解析 <%@ taglib %>，不依赖 jstl-1.2.jar 的索引；
         运行时容器同样按此映射加载，行为与使用 jar 内 TLD 一致。 -->
    <jsp-config>
        <taglib>
            <taglib-uri>http://java.sun.com/jsp/jstl/core</taglib-uri>
            <taglib-location>/WEB-INF/tlds/c.tld</taglib-location>
        </taglib>
    </jsp-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
