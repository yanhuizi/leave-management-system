<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>leave-management-system</display-name>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <context-param><param-name>applicationName</param-name><param-value>请假管理系统</param-value></context-param>
    <servlet>
        <servlet-name>appStartup</servlet-name>
        <servlet-class>com.huizi.leave.leavemanagementsystem.AppStartupServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping><servlet-name>appStartup</servlet-name><url-pattern>/app-status</url-pattern></servlet-mapping>

    <servlet><servlet-name>wildcardServlet</servlet-name><servlet-class>com.huizi.leave.leavemanagementsystem.WildcardServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>wildcardServlet</servlet-name><url-pattern>/demo/*</url-pattern></servlet-mapping>
    <servlet><servlet-name>genericDemo</servlet-name><servlet-class>com.huizi.leave.leavemanagementsystem.GenericDemoServlet</servlet-class><load-on-startup>2</load-on-startup></servlet>
    <servlet-mapping><servlet-name>genericDemo</servlet-name><url-pattern>/generic-demo</url-pattern></servlet-mapping>
</web-app>
